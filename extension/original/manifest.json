{
  "manifest_version": 3,
  "name": "ShadowGuard",
  "version": "1.0.0",
  "description": "Detects and masks PII in user inputs using AI",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["validated_policies.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
